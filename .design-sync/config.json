{
  "pkg": "@its/solaris-ui",
  "globalName": "SolarisUI",
  "shape": "package",
  "buildCmd": "npm run build",
  "provider": {
    "component": "SafeAreaProvider",
    "inner": {
      "component": "ThemeProvider",
      "inner": {
        "component": "AlertProvider"
      }
    }
  },
  "componentSrcMap": {
    "Alert": null,
    "SafeAreaProvider": null,
    "FAB": "src/components/FAB.tsx"
  },
  "docsDir": "../../.design-sync/docs",
  "guidelinesGlob": [
    "../../.design-sync/guidelines/*.md"
  ],
  "libOverrides": {
    "source-kit.mjs": "Solaris's List/ Modal/ Progress/ Tab/ ToggleButton/ src dirs are file organisation, not DS groups",
    "dts.mjs": "allowlist the all-caps component name FAB (ALL-CAPS-means-constant rule would drop it)"
  },
  "overrides": {
    "Accordion": {
      "cardMode": "column"
    },
    "AlertProvider": {
      "cardMode": "single",
      "primaryStory": "HostedDialog",
      "viewport": "560x420"
    },
    "AlertProviderWrapper": {
      "cardMode": "single",
      "primaryStory": "BindsTheSingleton",
      "viewport": "560x420"
    },
    "Autocomplete": {
      "cardMode": "column"
    },
    "Banner": {
      "cardMode": "column"
    },
    "Box": {
      "cardMode": "column"
    },
    "Breadcrumbs": {
      "cardMode": "column"
    },
    "Card": {
      "cardMode": "column"
    },
    "Checkbox": {
      "cardMode": "column"
    },
    "Chip": {
      "cardMode": "column"
    },
    "ConfirmDialog": {
      "cardMode": "single",
      "viewport": "560x400"
    },
    "DataGrid": {
      "cardMode": "column"
    },
    "DatePicker": {
      "cardMode": "column"
    },
    "DateTimePicker": {
      "cardMode": "column"
    },
    "Divider": {
      "cardMode": "column"
    },
    "FAB": {
      "cardMode": "column"
    },
    "Grid": {
      "cardMode": "column"
    },
    "Icon": {
      "cardMode": "column"
    },
    "IconButton": {
      "cardMode": "column"
    },
    "Link": {
      "cardMode": "column"
    },
    "ListItem": {
      "cardMode": "column"
    },
    "ListSection": {
      "cardMode": "column"
    },
    "Menu": {
      "cardMode": "single",
      "viewport": "480x460"
    },
    "Modal": {
      "cardMode": "single",
      "viewport": "560x440"
    },
    "NavigationBar": {
      "cardMode": "column"
    },
    "Paper": {
      "cardMode": "column"
    },
    "Portal": {
      "cardMode": "single",
      "primaryStory": "EscapesAClippingParent",
      "viewport": "460x260"
    },
    "SearchBar": {
      "cardMode": "column"
    },
    "Select": {
      "cardMode": "column"
    },
    "Skeleton": {
      "cardMode": "column"
    },
    "Snackbar": {
      "cardMode": "column"
    },
    "SpeedDial": {
      "cardMode": "column"
    },
    "Stack": {
      "cardMode": "column"
    },
    "Stepper": {
      "cardMode": "column"
    },
    "Tabs": {
      "cardMode": "column"
    },
    "ThemeProvider": {
      "cardMode": "column"
    },
    "ToastProvider": {
      "cardMode": "column"
    },
    "Toggle": {
      "cardMode": "column"
    },
    "Tooltip": {
      "cardMode": "column"
    }
  },
  "readmeHeader": ".design-sync/conventions.md"
}
